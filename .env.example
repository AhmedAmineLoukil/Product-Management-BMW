# Copy this file to .env for local development.
# Never commit .env. It is intentionally ignored by Git.

# Optional Supabase cloud sync. Leave blank for the local-only demo workspace.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only OpenAI configuration. Never prefix an API key with VITE_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_CHAT_MODEL=gpt-5-mini

# Credit guardrails for live AI runs.
# Keep these conservative for demos; raise only when you really need larger batches.
OPENAI_RUN_RECORD_LIMIT=20
OPENAI_MAX_INPUT_CHARS=40000
OPENAI_BUDGET_USD=60
AI_EXTRACT_WORKERS=2

# Optional. Set only if the app cannot find the project virtualenv automatically.
# PYTHON_BIN=.venv/Scripts/python.exe
