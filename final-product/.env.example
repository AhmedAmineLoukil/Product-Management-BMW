VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Server only. Never prefix an API key with VITE_.
# Repository .env is also supported. Values here override repository defaults;
# an explicitly empty OPENAI_API_KEY here disables that inherited key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_CHAT_MODEL=gpt-5-mini
# Start scripts set PYTHON_BIN automatically. Set it only for custom environments.
